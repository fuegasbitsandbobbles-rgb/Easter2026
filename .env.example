# Server settings
PORT=3000

# Where RSVP notifications should be sent (church/staff inbox)
RSVP_NOTIFICATION_EMAIL=John.Pastor@fakeemail.org

# "From" address shown on outgoing email
RSVP_FROM_EMAIL=no-reply@umcgs.org

# SMTP configuration for your real email provider
# Example providers: Gmail SMTP, SendGrid SMTP, Microsoft 365 SMTP, Mailgun SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
